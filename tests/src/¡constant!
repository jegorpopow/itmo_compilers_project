constant LENGTH is 100;
constant DOUBLE_LENGTH : integer is LENGTH * 2;

type table is array[LENGTH * DOUBLE_LENGTH] integer; 

routine meow(arr : array [LENGTH] real): real is 
  return arr[1];
end

routine table_receiver(t : table) : integer is
  print t[LENGTH * 2]; 
  return t[DOUBLE_LENGTH - LENGTH];
end

routine main() : integer is 
  var t is new table; 
  table_receiver(new table);
  print t[1];

  constant LENGTH is 300; 
  if LENGTH > DOUBLE_LENGTH then 
    print LENGTH;
    constant LENGTH is 400;
    print LENGTH;
  end

  print LENGTH;
end
