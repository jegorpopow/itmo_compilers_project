routine print_len(a : array[] integer) is
	print a.length;
end

routine factorial(n : integer) : integer is
	assert n >= 0;
	if n = 0 then
		return 1;
	else
		return n * factorial(n-1);
	end
end

routine main() is
	print_len(new [factorial(5)] array [] integer);
	print_len(new [0] array [] integer);
end
